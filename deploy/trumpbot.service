[Unit]
Description=Trumpbot Kalshi prediction-market trading bot
Documentation=https://github.com/sikai1228/trading-algo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trumpbot
Group=trumpbot
WorkingDirectory=/opt/trumpbot
EnvironmentFile=/etc/trumpbot/secrets.env
Environment=TRUMPBOT_CONFIG=/etc/trumpbot/config.yaml
ExecStart=/opt/trumpbot/.venv/bin/python -m trumpbot --config /etc/trumpbot/config.yaml
Restart=on-failure
RestartSec=10s
StartLimitBurst=10
StartLimitIntervalSec=120

# Logging.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trumpbot

# Resource limits (CLAUDE.md "Backend Infrastructure").
MemoryMax=2G
CPUQuota=80%

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/trumpbot /var/log/trumpbot
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
